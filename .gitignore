# Machine-specific Claude Code permissions
.claude/settings.local.json

# Snapshots are private design system data. They live outside this repo now
# (../ds-snapshots), so there is nothing here to ignore. These two lines stay as
# a guard against a stray copy being committed by someone following older
# instructions.
#
# example.snapshot.json is the committed exception: synthetic, invented names.
snapshot/*
!snapshot/example.snapshot.json
ds-snapshots/
viewer/src/snapshot.json
